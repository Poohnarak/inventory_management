# Server
PORT=4000
NODE_ENV=development

# System database (super admins + shop registry)
SYSTEM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_system?schema=public"

# Base connection URL for per-shop databases (db name is appended automatically)
# Each shop gets two databases: <shop>_users and <shop>_app
SHOP_DATABASE_BASE_URL="postgresql://postgres:postgres@localhost:5432"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
