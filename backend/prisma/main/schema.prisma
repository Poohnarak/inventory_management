// Main database schema: shops and users (multi-tenant registry)
generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client/main"
}

datasource db {
  provider = "postgresql"
  url      = env("MAIN_DATABASE_URL")
}

model Shop {
  id        Int      @id @default(autoincrement())
  shopCode  String   @unique @map("shop_code")
  shopName  String   @map("shop_name")
  dbName    String   @unique @map("db_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("shops")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String
  passwordHash String   @map("password_hash")
  role         String   @default("STAFF") // ADMIN or STAFF
  shopId       Int      @map("shop_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([username, shopId])
  @@map("users")
}
