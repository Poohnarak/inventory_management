{
  "name": "inventory-management-backend",
  "version": "2.0.0",
  "description": "Multi-tenant backend API for restaurant/shop inventory management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "npm run prisma:generate:main && npm run prisma:generate:shop",
    "prisma:generate:main": "npx prisma generate --schema=prisma/main/schema.prisma",
    "prisma:generate:shop": "npx prisma generate --schema=prisma/shop/schema.prisma",
    "prisma:migrate:main": "npx prisma migrate dev --schema=prisma/main/schema.prisma",
    "prisma:migrate:shop": "SHOP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop_demo?schema=public npx prisma migrate dev --schema=prisma/shop/schema.prisma",
    "prisma:migrate:prod:main": "npx prisma migrate deploy --schema=prisma/main/schema.prisma",
    "prisma:migrate:prod:shop": "npx prisma migrate deploy --schema=prisma/shop/schema.prisma",
    "prisma:studio:main": "npx prisma studio --schema=prisma/main/schema.prisma",
    "prisma:studio:shop": "SHOP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop_demo?schema=public npx prisma studio --schema=prisma/shop/schema.prisma",
    "seed": "node prisma/seed.js",
    "shop:create-db": "node scripts/create-shop-db.js"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.3.0"
  }
}
